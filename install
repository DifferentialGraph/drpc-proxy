#!/bin/bash -i
[ -z $DRPC_DIR ] && DRPC_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-${(%):-%x}}")" && pwd)"

basics-install() {
    apt update
    apt -y install ca-certificates curl grep git
}

docker-install() {
    if ! grep -q "docker" <<< $(find /etc/apt/ -name *.list | xargs cat | grep  ^[[:space:]]*deb | grep -v deb-src); then
        echo "Installing Docker..."
        install -m 0755 -d /etc/apt/keyrings
        curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc
        chmod a+r /etc/apt/keyrings/docker.asc
        echo \
            "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/ubuntu \
            $(. /etc/os-release && echo "$VERSION_CODENAME") stable" | \
            sudo tee /etc/apt/sources.list.d/docker.list > /dev/null
            apt update && apt install docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin docker-compose
        apt -y install docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin docker-compose
    fi
}

nodejs-install() {
    if [ ! -d "$HOME/.nvm" ]; then
        echo "Adding NVM"
        apt -y install curl grep
        curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.40.0/install.sh | bash
        source $HOME/.bashrc
        nvm install --lts
        nvm use --lts
    fi

    if [ `npm list -g | grep -c pino-pretty` -eq 0 ]; then
        echo "Adding Pino Pretty"
        npm install -g pino-pretty
    fi
}

# rsa keys
rsakeys-generate() {
    whiptail --title "DRPC Proxy" --yesno "Generate RSA keys?" 8 78 || { echo "User exit"; return; }

    apt -y install openssl
    openssl genrsa -out ./keys/private-$PROVIDER.pem 2048
    openssl rsa -in ./keys/private-$PROVIDER.pem -pubout -out ./keys/public-$PROVIDER.pem
    openssl pkcs8 -topk8 -inform PEM -outform PEM -in ./keys/private-$PROVIDER.pem -out ./keys/private-$PROVIDER.p8.key -nocrypt
    rm ./keys/private-$PROVIDER.pem
}

reverseproxy-check() {
    if [ "$( docker container inspect -f '{{.State.Running}}' nginx-proxy )" = "false" ] || [ "$( docker container inspect -f '{{.State.Running}}' nginx-ssl )" = "false" ]; then
        return 1
    fi
}

build_config() {
    # set -euo pipefail
    [ -z $1 ] && { echo "Error: select destination path for config file"; return 1; }
    [ -f "$DRPC_DIR/.env.user" ] || { echo "Error: .env.user file not found"; return 1; }
    source $DRPC_DIR/.env.user

    INPUT="$DRPC_DIR/configs/dshackle.yaml"
    [ -f "$INPUT" ] || { echo "ERROR: $INPUT does not exist" >&2; return 1; }
    OUTPUT="${1}/${PROVIDER}-dshackle.yaml"

    export PROVIDER=$PROVIDER HOST=$HOST
    envsubst < "$INPUT" > "$OUTPUT"

    {
        echo
        echo "cluster:"
        echo "  upstreams:"
    } >> "$OUTPUT"

    for i in "${!CHAINS[@]}"; do
        export ID=${IDS[i]} RPC=${RPCS[i]} WS=${WSS[i]}

        CHAIN="$DRPC_DIR/configs/${CHAINS[i]}.yaml"
        if [[ ! -f "$CHAIN" ]]; then
            echo "WARNING: $CHAIN not found, skipping" >&2
            continue
        fi

        CLIENT="${CLIENTS[i]}"
        awk -v key="$CLIENT" '
            $0 ~ "^" key ":" { in_block=1; next }  # start after "opt_*:" line
            /^[^[:space:]]/ && in_block { exit }  # next top-level key = stop
            in_block { print }                    # lines inside the block
        ' "$CHAIN" \
            | envsubst \
            | sed '/^[[:space:]]*$/d' \
            | sed 's/^/  /' \
            >> "$OUTPUT"
    done
}

drpc-start() {
    if [ -f "$DRPC_DIR/docker-compose.yml" ]; then
        build_config ${CONFIG_PATH:-${DRPC_DIR}}

        COMPOSE_FILE=$DRPC_DIR/docker-compose.yml docker compose --env-file $DRPC_DIR/.env.user pull
        COMPOSE_FILE=$DRPC_DIR/docker-compose.yml docker compose --env-file $DRPC_DIR/.env.user up -d --remove-orphans --build

        if [ ! -z "$DOCKER_NETWORKS" ]; then
            nets=$(docker container inspect --format '{{range $net,$v := .NetworkSettings.Networks}}{{printf "%s\n" $net}}{{end}}' drpc-proxy)
            for NETWORK in ${DOCKER_NETWORKS[@]}; do
                [[ ! ${nets[@]} =~ "$NETWORK" ]] && docker network connect $NETWORK drpc-proxy
            done
        fi
    else
        echo "DRPC proxy configuration file not found."
        return 1
    fi
}

drpcproxy-install() {
    # if [ -f "./config/config.yaml" ]; then
    #     export PROVIDER HOST
    #     envsubst < ./config/config.yaml > ./config/config-tmp.yaml
    #     rm ./config/config.yaml && mv ./config/config-tmp.yaml ./config/config.yaml
    # else
    #     return 1
    # fi
    #
    # DRPC_CONFIG_PATH=/var/lib/docker/volumes/reverse-proxy_vhost/_data/
    # echo 'grpc_pass grpcs://drpc.'${HOST}';' > ${DRPC_CONFIG_PATH}/drpc.${HOST}_location
    #
    # docker compose --env-file .env.user up -d --remove-orphans --build
    # sleep 1
    #
    # if [ ! -z "$PROVIDER_CHAINS" ]; then
    #     for CHAIN in ${PROVIDER_CHAINS[@]}; do
    #         docker network connect $CHAIN drpc-proxy
    #     done
    # fi
    #
    # unset PROVIDER HOST

    if ! grep -q "#drpc-setup" ~/.bashrc; then
        echo "Modifying .bashrc ..."
        DIR="$( cd "$( dirname -- $0 )" && pwd )"
        echo -e "\n" >> ~/.bashrc
        echo "#drpc-setup" >> ~/.bashrc
        echo "export DRPC_DIR=$DRPC_DIR" >> ~/.bashrc
        echo 'source $DRPC_DIR/utils/manage' >> ~/.bashrc
        source ~/.bashrc
    fi
}

if [ "${1}" != "--source" ]; then
    apt update && apt install -y whiptail
    whiptail --title "DRPC Proxy" --yesno "Install DPRC Proxy?" 8 78 || { echo "User exit"; exit 1; }

    # basics
    basics-install || { echo "Error: could not install basic tools"; exit 1; }

    # var
    if [ -f ".env.user" ]; then
        source .env.user
    else
        echo "Error: environment file not found";
        exit 1;
    fi

    # docker
    docker-install || { echo "Error: could not install Docker"; exit 1; }

    # node.js (better log visualization)
    nodejs-install || { echo "Error: could not install Node.js"; exit 1; }

    # rsa keys
    rsakeys-generate || { echo "Error: could not generate RSA keys"; exit 1; }

    # reverse proxy
    reverseproxy-check || { echo "Error: reverse proxy not running"; exit 1; }

    # drpc
    drpcproxy-install || { echo "Error: could not install DRPC proxy"; exit 1; }
fi
